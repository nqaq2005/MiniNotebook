# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CUSTOM_API_KEY=your_custom_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Model & Endpoint Settings
# LLM_PROVIDER: "gemini" (Google Gemini API / Gemini Proxy) or "custom" (OpenAI-compatible /v1/chat/completions: Ollama, vLLM, LiteLLM, OpenRouter)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Optional custom endpoint URL:
# - Example for Ollama/vLLM/OpenAI-compatible: http://localhost:11434/v1
# - Example for Gemini custom proxy: https://my-gemini-proxy.com/v1beta/models
LLM_BASE_URL=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Storage Paths
RAW_PDF_DIR=data/raw_pdfs
PARSED_MD_DIR=data/parsed_md
VECTOR_DB_DIR=data/vector_db
CITATION_GRAPH_PATH=data/citation_graph/graph.json
# Optional Qdrant Server URL (e.g. http://localhost:6333 when running via docker-compose). Leave empty for local disk mode.
QDRANT_URL=
QDRANT_COLLECTION_NAME=research_papers
